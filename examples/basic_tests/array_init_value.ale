// The second argument of array(n, v) is the initial value of every element
// (shared and local, int and float). It used to be ignored.

procedure main()
    print "array init test start"
    shared mutable s := array(4, 7)
    shared mutable f := array(3, 1.5)
    shared mutable z := array(3, 0)
    mutable l := array(4, 9)
    mutable lf := array(2, -2.5)
    mutable lz := array(3, 0)

    mutable shared_sum := 0
    for i := 0 to 4 do
        shared_sum := shared_sum + s[i]
    end for
    print `shared int sum = {shared_sum}`

    mutable f2 := f[2]
    print `shared float f[2] = {f2}`

    mutable z1 := z[1]
    print `shared zero z[1] = {z1}`

    mutable local_sum := 0
    for i := 0 to 4 do
        local_sum := local_sum + l[i]
    end for
    print `local int sum = {local_sum}`

    mutable lf1 := lf[1]
    print `local float lf[1] = {lf1}`

    mutable lz2 := lz[2]
    print `local zero lz[2] = {lz2}`
    print "array init test end"
end procedure
