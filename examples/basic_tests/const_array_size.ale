// Array and queue sizes may be constant expressions, not only integer literals.
// A non-constant size used to be silently replaced by 10 elements.

procedure main()
    print "const size test start"
    shared const n = 5
    shared mutable a := array(n * n + 1, 0)
    shared mutable q as queue := queue(n - 2)
    const m = 4
    mutable b := array(m * 3, 0)

    for i := 0 to n * n + 1 do
        a[i] := i
    end for
    mutable sum := 0
    for i := 0 to n * n + 1 do
        sum := sum + a[i]
    end for
    print `shared array sum = {sum}`

    for i := 0 to m * 3 do
        b[i] := 2 * i
    end for
    mutable last := b[11]
    print `local array last = {last}`

    for i := 0 to 6 do
        enqueue(q, i)
    end for
    const sz = queue_size(q)
    print `queue size = {sz}`
    print "const size test end"
end procedure
