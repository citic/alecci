// DRB039 – True dependence on a single element: a[i] = a[i] + a[0]
// Full translation of DRB039-truedepsingleelement-orig-yes.c (only a[0] is set in C;
// the other elements are uninitialised there and 0 here).
// Race: a[0] (read by every iteration) vs a[0] (written by iteration 0)
// label: Y1
procedure main()
    shared const len = 1000
    shared mutable a := array(1000, 0)
    a[0] := 2

    // #pragma omp parallel for
    parallel for i := 0 to len with 4 thread do
        a[i] := a[i] + a[0]
    end parallel for

    print `a[500]={a[500]}`
end procedure
