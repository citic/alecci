// DRB002 – Anti-dependence (variable-length array version): a[i] = a[i+1] + 1
// Full translation of DRB002-antidep1-var-yes.c; len is 1000 unless argv[1] is given.
// Shared Alecci arrays need a literal size, so the array holds 1000 elements and
// len is clamped to that capacity.
// Race: a[i+1] (read by iteration i) vs a[i] (written by iteration i+1) in the parallel for
// label: Y1
procedure main(argc, argv as array)
    shared mutable len := 1000
    if argc > 1 then
        len := int(argv[1])
    end if
    if len > 1000 then
        len := 1000
    end if
    shared mutable a := array(1000, 0)
    for i := 0 to len do
        a[i] := i
    end for

    // #pragma omp parallel for
    parallel for i := 0 to len - 1 with 4 thread do
        a[i] := a[i + 1] + 1
    end parallel for
end procedure
