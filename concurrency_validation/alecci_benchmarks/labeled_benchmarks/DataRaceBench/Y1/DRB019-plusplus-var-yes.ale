// DRB019 – Missing critical (variable-length array version)
// Full translation of DRB019-plusplus-var-yes.c; inLen is 1000 unless argv[1] is given.
// Shared Alecci arrays need a literal size, so the arrays hold 1000 elements and
// inLen is clamped to that capacity.
// Race: outLen (write) vs outLen (write/read) and output[] (write) vs output[] (write)
// label: Y1
procedure main(argc, argv as array)
    shared mutable in_len := 1000
    shared mutable outLen := 0
    if argc > 1 then
        in_len := int(argv[1])
    end if
    if in_len > 1000 then
        in_len := 1000
    end if
    shared mutable input := array(1000, 0)
    shared mutable output := array(1000, 0)
    for i := 0 to in_len do
        input[i] := i
    end for

    // #pragma omp parallel for
    parallel for i := 0 to in_len with 4 thread do
        output[outLen] := input[i]
        outLen := outLen + 1
    end parallel for

    print `output[0]={output[0]}`
end procedure
