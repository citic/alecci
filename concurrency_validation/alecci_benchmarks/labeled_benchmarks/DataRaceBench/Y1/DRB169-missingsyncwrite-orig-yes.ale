// DRB169 – Missing sync write: several threads write r1[k] at the same time
// Full translation of DRB169-missingsyncwrite-orig-yes.c (N = 8); double r[N][N][N]
// is flattened to r[i * 64 + j * 8 + k].
// Race: r1[k] (written by one thread) vs r1[k] (written by another thread)
// label: Y1
procedure main()
    shared const n = 8
    shared mutable r1 := array(8, 0.0)
    shared mutable r := array(512, 0.0)

    for i := 0 to n do
        for j := 0 to n do
            for k := 0 to n do
                r[i * 64 + j * 8 + k] := i
            end for
        end for
    end for

    // #pragma omp parallel for default(shared) private(j,k)
    parallel for i := 1 to n - 1 with 4 thread do
        for j := 1 to n - 1 do
            for k := 0 to n do
                r1[k] := r[i * 64 + (j - 1) * 8 + k] + r[i * 64 + (j + 1) * 8 + k] + r[(i - 1) * 64 + j * 8 + k] + r[(i + 1) * 64 + j * 8 + k]
            end for
        end for
    end parallel for

    for k := 0 to n do
        print `{r1[k]} `
    end for
    print ``
end procedure
