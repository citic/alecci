// DRB032 – True dependence on the first dimension (variable-length array version)
// Full translation of DRB032-truedepfirstdimension-var-yes.c; len is 100 unless
// argv[1] is given (the C default is 1000: with 400 x 400 or more ThreadSanitizer no
// longer reports the chunk-boundary race, so the default was reduced).
// double b[len][len] is flattened to b[i * len + j]. Shared Alecci arrays need a
// literal size, so the array holds 100 x 100 elements and len is clamped to 100.
// Race: b[i-1][j-1] (read by iteration i) vs b[i][j] (written by iteration i-1)
// label: Y1
procedure main(argc, argv as array)
    shared mutable len := 100
    if argc > 1 then
        len := int(argv[1])
    end if
    if len > 100 then
        len := 100
    end if
    shared mutable n := len
    shared mutable m := len
    shared mutable b := array(10000, 0.0)
    for i := 0 to n do
        for j := 0 to m do
            b[i * len + j] := 0.5
        end for
    end for

    // #pragma omp parallel for private(j)
    parallel for i := 1 to n with 4 thread do
        for j := 1 to m do
            b[i * len + j] := b[(i - 1) * len + (j - 1)]
        end for
    end parallel for
end procedure
