// DRB003 – Anti-dependence (2D): a[i][j] += a[i+1][j] on the outer level
// Full translation of DRB003-antidep2-orig-yes.c; double a[20][20] is flattened to
// a[i * 20 + j].
// Race: a[i+1][j] (read by iteration i) vs a[i][j] (written by iteration i+1)
// label: Y1
procedure main()
    shared const len = 20
    shared mutable a := array(400, 0.0)
    for i := 0 to len do
        for j := 0 to len do
            a[i * 20 + j] := 0.5
        end for
    end for

    // #pragma omp parallel for private(j)
    parallel for i := 0 to len - 1 with 4 thread do
        for j := 0 to len do
            a[i * 20 + j] := a[i * 20 + j] + a[(i + 1) * 20 + j]
        end for
    end parallel for

    print `a[10][10]={a[10 * 20 + 10]}`
end procedure
