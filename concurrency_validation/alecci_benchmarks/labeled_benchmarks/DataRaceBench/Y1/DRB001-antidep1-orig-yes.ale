// DRB001 – Anti-dependence: a[i] = a[i+1] + 1
// Full translation of DRB001-antidep1-orig-yes.c
// Race: a[i+1] (read by iteration i) vs a[i] (written by iteration i+1) in the parallel for
// label: Y1
procedure main()
    shared const len = 1000
    shared mutable a := array(1000, 0)
    for i := 0 to len do
        a[i] := i
    end for

    // #pragma omp parallel for
    parallel for i := 0 to len - 1 with 4 thread do
        a[i] := a[i + 1] + 1
    end parallel for

    print `a[500]={a[500]}`
end procedure
