// DRB030 – True dependence (variable-length array version): a[i+1] = a[i] + 1
// Full translation of DRB030-truedep1-var-yes.c; len is 100 unless argv[1] is given.
// Shared Alecci arrays need a literal size, so the array holds 100 elements and
// len is clamped to that capacity.
// Race: a[i+1] (write) vs a[i] (read from the adjacent iteration)
// label: Y1
procedure main(argc, argv as array)
    shared mutable len := 100
    if argc > 1 then
        len := int(argv[1])
    end if
    if len > 100 then
        len := 100
    end if
    shared mutable a := array(100, 0)
    for i := 0 to len do
        a[i] := i
    end for

    // #pragma omp parallel for
    parallel for i := 0 to len - 1 with 4 thread do
        a[i + 1] := a[i] + 1
    end parallel for
end procedure
