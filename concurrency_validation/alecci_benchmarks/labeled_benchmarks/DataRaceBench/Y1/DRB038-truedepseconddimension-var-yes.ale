// DRB038 – True dependence on the second dimension (variable-length array version)
// Full translation of DRB038-truedepseconddimension-var-yes.c; only the inner j loop is
// a parallel for. len is 1000 unless argv[1] is given (as in C). double b[n][m] is flattened to b[i * len + j]; row_i
// carries the sequential i into the parallel for body. Shared Alecci arrays need a
// literal size, so the array holds 1000 x 1000 elements and len is clamped to 1000.
// Race: b[i][j-1] (read by iteration j) vs b[i][j-1] (written by iteration j-1)
// label: Y1
procedure main(argc, argv as array)
    shared mutable len := 1000
    if argc > 1 then
        len := int(argv[1])
    end if
    if len > 1000 then
        len := 1000
    end if
    shared mutable n := len
    shared mutable m := len
    shared mutable b := array(1000000, 0.0)
    shared mutable row_i := 0

    for i := 0 to n do
        row_i := i
        // #pragma omp parallel for
        parallel for j := 1 to m with 4 thread do
            b[row_i * len + j] := b[row_i * len + (j - 1)]
        end parallel for
    end for
end procedure
