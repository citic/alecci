// DRB075 – omp_get_thread_num(): thread 0 writes numThreads while the others read it
// Full translation of DRB075-getthreadnum-orig-yes.c; the default team of
// "#pragma omp parallel" is modelled as 4 threads.
// Race: numThreads (written by thread 0) vs numThreads (read by threads 1-3), no sync
// label: Y1
procedure main()
    shared mutable numThreads := 0

    // #pragma omp parallel
    mutable threads := create_threads(4, worker)
    join_threads(threads, 4)
end procedure

procedure worker(thread_number as int)
    if thread_number = 0 then
        numThreads := 4
    else
        print `numThreads={numThreads}`
    end if
end procedure
