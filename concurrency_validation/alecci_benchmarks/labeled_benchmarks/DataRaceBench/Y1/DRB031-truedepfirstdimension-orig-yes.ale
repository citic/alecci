// DRB031 – True dependence on the first dimension: b[i][j] = b[i-1][j-1]
// Full translation of DRB031-truedepfirstdimension-orig-yes.c; double b[1000][1000]
// is scaled to 100 x 100 and flattened to b[i * 100 + j]. With the original 1000 x 1000
// size (and already from 400 x 400) ThreadSanitizer no longer reports the race
// between the chunk-boundary rows, so the size was reduced to keep the benchmark
// observable.
// Race: b[i-1][j-1] (read by iteration i) vs b[i][j] (written by iteration i-1)
// label: Y1
procedure main()
    shared const n = 100
    shared const m = 100
    shared mutable b := array(10000, 0.0)
    for i := 0 to n do
        for j := 0 to m do
            b[i * 100 + j] := 0.5
        end for
    end for

    // #pragma omp parallel for private(j)
    parallel for i := 1 to n with 4 thread do
        for j := 1 to m do
            b[i * 100 + j] := b[(i - 1) * 100 + (j - 1)]
        end for
    end parallel for

    print `b[50][50]={b[50 * 100 + 50]}`
end procedure
