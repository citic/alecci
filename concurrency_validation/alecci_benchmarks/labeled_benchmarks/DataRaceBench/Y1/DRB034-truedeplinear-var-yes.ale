// DRB034 – True dependence with a linear subscript (variable-length array version)
// Full translation of DRB034-truedeplinear-var-yes.c; len is 2000 unless argv[1] is
// given. Shared Alecci arrays need a literal size, so the array holds 2000 elements
// and len is clamped to that capacity.
// Race: a[2*i+1] (write by iteration i) vs a[i] (read by another iteration)
// label: Y1
procedure main(argc, argv as array)
    shared mutable len := 2000
    if argc > 1 then
        len := int(argv[1])
    end if
    if len > 2000 then
        len := 2000
    end if
    shared mutable a := array(2000, 0)
    for i := 0 to len do
        a[i] := i
    end for

    // #pragma omp parallel for
    parallel for i := 0 to len # 2 with 4 thread do
        a[2 * i + 1] := a[i] + 1
    end parallel for
end procedure
