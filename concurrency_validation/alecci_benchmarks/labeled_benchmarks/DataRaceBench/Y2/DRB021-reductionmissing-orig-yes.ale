// DRB021 – Missing reduction: sum is accumulated without synchronisation
// Full translation of DRB021-reductionmissing-orig-yes.c; float u[100][100] is
// flattened to u[i * 100 + j]; temp is private (declared in the loop body).
// Race: sum (write) vs sum (write) and sum (write) vs sum (read) across threads
// label: Y2
procedure main()
    shared const len = 100
    shared mutable u := array(10000, 0.0)
    shared mutable sum as float := 0.0

    for i := 0 to len do
        for j := 0 to len do
            u[i * 100 + j] := 0.5
        end for
    end for

    // #pragma omp parallel for private(temp, i, j)
    parallel for i := 0 to len with 4 thread do
        mutable temp as float := 0.0
        for j := 0 to len do
            temp := u[i * 100 + j]
            sum := sum + temp * temp
        end for
    end parallel for

    print `sum = {sum}`
end procedure
