// DRB023 – Two sections without synchronisation write the shared i
// Full translation of DRB023-sections1-orig-yes.c (the source file behind this
// benchmark): "#pragma omp parallel sections" with two sections, modelled as two
// threads, one per section.
// Race: i (written by section 1) vs i (written by section 2)
// label: Y2
procedure main()
    shared mutable i := 0

    // #pragma omp parallel sections
    mutable threads := create_threads(2, worker)
    join_threads(threads, 2)

    print `i={i}`
end procedure

procedure worker(thread_number as int)
    if thread_number = 0 then
        // #pragma omp section
        i := 1
    else
        // #pragma omp section
        i := 2
    end if
end procedure
