// DRB020 – Missing private: tmp should be private but is shared
// Full translation of DRB020-privatemissing-var-yes.c (the source file behind this
// benchmark); len is 100 unless argv[1] is given. Shared Alecci arrays need a literal
// size, so the array holds 100 elements and len is clamped to that capacity.
// Race: tmp (write) vs tmp (read) and tmp (write) vs tmp (write) across threads
// label: Y2
procedure main(argc, argv as array)
    shared mutable len := 100
    shared mutable tmp := 0
    if argc > 1 then
        len := int(argv[1])
    end if
    if len > 100 then
        len := 100
    end if
    shared mutable a := array(100, 0)
    for i := 0 to len do
        a[i] := i
    end for

    // #pragma omp parallel for
    parallel for i := 0 to len with 4 thread do
        tmp := a[i] + i
        a[i] := tmp
    end parallel for
end procedure
