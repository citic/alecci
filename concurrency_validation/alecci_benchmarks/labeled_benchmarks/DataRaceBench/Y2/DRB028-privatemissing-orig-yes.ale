// DRB028 – Missing private: tmp should be private but is shared
// Full translation of DRB028-privatemissing-orig-yes.c
// Race: tmp (write) vs tmp (read) and tmp (write) vs tmp (write) across threads
// label: Y2
procedure main()
    shared const len = 100
    shared mutable a := array(100, 0)
    shared mutable tmp := 0
    for i := 0 to len do
        a[i] := i
    end for

    // #pragma omp parallel for
    parallel for i := 0 to len with 4 thread do
        tmp := a[i] + i
        a[i] := tmp
    end parallel for

    print `a[50]={a[50]}`
end procedure
