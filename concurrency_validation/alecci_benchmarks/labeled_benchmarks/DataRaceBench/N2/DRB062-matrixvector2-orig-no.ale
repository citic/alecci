// DRB062 – Matrix-vector multiplication: inner-level parallelization with a reduction
// Full translation of DRB062-matrixvector2-orig-no.c 
// (N = 1000); double a[N][N], v[N], v_out[N] are global (zero-initialised) and
// a[i][j] is flattened to a[i * 1000 + j]; row carries the sequential i into the
// parallel for body.
// reduction(+:sum) is modelled as updates of the shared sum under a mutex.
// No race: the outer loop is sequential; the inner parallel for only touches sum
// under the mutex
// label: N2
procedure main()
    shared const n = 1000
    shared mutable a := array(1000000, 0.0)
    shared mutable v := array(1000, 0.0)
    shared mutable v_out := array(1000, 0.0)
    shared mutable sum as float := 0.0
    shared mutable mtx as mutex := mutex()
    shared mutable row as int := 0

    // mv()
    for i := 0 to n do
        row := i
        sum := 0.0
        // #pragma omp parallel for reduction(+:sum)
        parallel for j := 0 to n with 4 thread do
            lock(mtx)
            sum := sum + a[row * 1000 + j] * v[j]
            unlock(mtx)
        end parallel for
        v_out[row] := sum
    end for
end procedure
