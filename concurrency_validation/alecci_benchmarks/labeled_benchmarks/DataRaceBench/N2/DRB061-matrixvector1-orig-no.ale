// DRB061 – Matrix-vector multiplication: outer-level loop parallelization
// Full translation of DRB061-matrixvector1-orig-no.c: N = 100, double a[N][N], v[N],
// v_out[N] (global, so zero-initialised); a[i][j] is flattened to a[i * 100 + j].
// No race: each thread owns a distinct i and writes v_out[i]; a and v are read-only
// label: N2
procedure main()
    shared const n = 100
    shared mutable a := array(10000, 0.0)
    shared mutable v := array(100, 0.0)
    shared mutable v_out := array(100, 0.0)

    // mv()
    // #pragma omp parallel for private(i,j)
    parallel for i := 0 to n with 4 thread do
        mutable sum as float := 0.0
        for j := 0 to n do
            sum := sum + a[i * 100 + j] * v[j]
        end for
        v_out[i] := sum
    end parallel for
end procedure
