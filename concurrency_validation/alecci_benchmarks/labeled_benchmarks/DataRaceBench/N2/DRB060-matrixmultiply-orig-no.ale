// DRB060 – Classic i-k-j matrix multiplication (including the C source's c[i][j] index)
// Full translation of DRB060-matrixmultiply-orig-no.c: N = M = K = 100, double
// a[N][M], b[M][K], c[N][K] (global, so zero-initialised) flattened to x[i * 100 + j].
// No race: each iteration i writes only row c[i][*]; a and b are read-only
// label: N2
procedure main()
    shared const n = 100
    shared const m = 100
    shared const kk = 100
    shared mutable a := array(10000, 0.0)
    shared mutable b := array(10000, 0.0)
    shared mutable c := array(10000, 0.0)

    // mmm()
    // #pragma omp parallel for private(j,k)
    parallel for i := 0 to n with 4 thread do
        for k := 0 to kk do
            for j := 0 to m do
                c[i * 100 + j] := c[i * 100 + j] + a[i * 100 + k] * b[k * 100 + j]
            end for
        end for
    end parallel for
end procedure
