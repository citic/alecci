// DRB093 – DOALL2 with collapse(2): every element a[i][j] is incremented independently
// Full translation of DRB093-doall2-collapse-orig-no.c: int a[100][100] (global, zero)
// flattened to a[i * 100 + j]; collapse(2) over (i, j) is one parallel for over the
// 10000 flattened iterations.
// No race: each iteration writes a distinct element
// label: N2
procedure main()
    shared mutable a := array(10000, 0)

    // #pragma omp parallel for collapse(2)
    parallel for ij := 0 to 10000 with 4 thread do
        a[ij] := a[ij] + 1
    end parallel for
end procedure
