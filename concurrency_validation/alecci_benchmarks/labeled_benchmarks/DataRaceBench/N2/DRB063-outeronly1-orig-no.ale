// DRB063 – Outer-only parallelism: b[i][j] = b[i][j+1], only the outer loop is parallel
// Full translation of DRB063-outeronly1-orig-no.c: n = m = 100, double b[100][100]
// (global, so zero-initialised) flattened to b[i * 100 + j].
// No race: each thread owns whole rows of b; the inner j loop is sequential
// label: N2
procedure main()
    shared const n = 100
    shared const m = 100
    shared mutable b := array(10000, 0.0)

    // foo()
    // #pragma omp parallel for private(j)
    parallel for i := 0 to n with 4 thread do
        for j := 0 to m - 1 do
            b[i * 100 + j] := b[i * 100 + j + 1]
        end for
    end parallel for
end procedure
