// DRB048 – Firstprivate: every thread adds its private copy of g to a[i]
// Full translation of DRB048-firstprivate-orig-no.c; foo(a, 100, 7) is inlined in main
// (a is the global int a[100], n = 100, g = 7). g is a read-only constant, which is
// what firstprivate(g) amounts to.
// No race: each iteration writes a distinct element a[i]
// label: N2
procedure main()
    shared const n = 100
    shared const g = 7
    shared mutable a := array(100, 0)

    // #pragma omp parallel for firstprivate(g)
    parallel for i := 0 to n with 4 thread do
        a[i] := a[i] + g
    end parallel for
end procedure
