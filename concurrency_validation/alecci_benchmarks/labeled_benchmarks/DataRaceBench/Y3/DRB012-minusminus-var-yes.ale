// DRB012 – Missing critical (argv version): unprotected decrement of a shared counter
// Full translation of DRB012-minusminus-var-yes.c; len is 100 unless argv[1] is given.
// Shared Alecci arrays need a literal size, so x holds 100 elements and len is
// clamped to that capacity. The C loop counts i downwards; the parallel for runs
// upwards over the same indices.
// Race: numNodes2 (write) vs numNodes2 (write) across threads
// label: Y3
procedure main(argc, argv as array)
    shared mutable len := 100
    if argc > 1 then
        len := int(argv[1])
    end if
    if len > 100 then
        len := 100
    end if
    shared mutable x := array(100, 0)
    shared mutable numNodes2 := 0

    for i := 0 to len do
        if i mod 2 = 0 then
            x[i] := 5
        else
            x[i] := -5
        end if
    end for

    // #pragma omp parallel for
    parallel for i := 0 to len with 4 thread do
        if x[i] <= 0 then
            numNodes2 := numNodes2 - 1
        end if
    end parallel for
end procedure
