// DRB011 – Missing critical: unprotected decrement of a shared counter
// Full translation of DRB011-minusminus-orig-yes.c (the C loop counts i downwards,
// numNodes - 1 to 0; the parallel for here runs upwards over the same indices,
// which does not change which elements are visited).
// Race: numNodes2 (write) vs numNodes2 (write) across threads
// label: Y3
procedure main()
    shared const len = 100
    shared mutable x := array(100, 0)
    shared mutable numNodes2 := 0

    // initialize x[]
    for i := 0 to len do
        if i mod 2 = 0 then
            x[i] := 5
        else
            x[i] := -5
        end if
    end for

    // #pragma omp parallel for
    parallel for i := 0 to len with 4 thread do
        if x[i] <= 0 then
            numNodes2 := numNodes2 - 1
        end if
    end parallel for

    print `numNodes2 = {numNodes2}`
end procedure
