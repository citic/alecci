// DRB053 – Inner-only parallelism: the outer loop is sequential, the inner one parallel
// Full translation of DRB053-inneronly1-orig-no.c; double a[20][20] (zeroed by
// memset) is flattened to a[i * 20 + j]; row_i carries the sequential i into the
// parallel for body.
// No race: for each i the parallel for writes distinct elements a[i][j] and only
// reads row i+1
// label: N1
procedure main()
    shared mutable a := array(400, 0.0)
    shared mutable row_i := 0

    for i := 0 to 19 do
        row_i := i
        // #pragma omp parallel for
        parallel for j := 0 to 20 with 4 thread do
            a[row_i * 20 + j] := a[row_i * 20 + j] + a[(row_i + 1) * 20 + j]
        end parallel for
    end for
end procedure
