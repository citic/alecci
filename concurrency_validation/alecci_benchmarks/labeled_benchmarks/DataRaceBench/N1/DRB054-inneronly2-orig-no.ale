// DRB054 – Inner-only parallelism (2): b[i][j] = b[i-1][j-1], outer loop sequential
// Full translation of DRB054-inneronly2-orig-no.c (n = m = 100); double b[n][m] is
// flattened to b[i * 100 + j]; row_i carries the sequential i into the parallel for
// body.
// No race: for each i the parallel for writes distinct elements b[i][j] and only
// reads row i-1
// label: N1
procedure main()
    shared const n = 100
    shared const m = 100
    shared mutable b := array(10000, 0.0)
    shared mutable row_i := 0

    for i := 0 to n do
        for j := 0 to n do
            b[i * 100 + j] := i * j
        end for
    end for

    for i := 1 to n do
        row_i := i
        // #pragma omp parallel for
        parallel for j := 1 to m with 4 thread do
            b[row_i * 100 + j] := b[(row_i - 1) * 100 + (j - 1)]
        end parallel for
    end for
end procedure
