// Full translation of for-loop_-_main.c (second benchmark built from the same source
// as array-add-pfor-no).
// No race: every iteration writes a distinct element c[i].
// Deviation: schedule(static, chunk) with chunk = 100 is Alecci's block
// distribution of the 1000 iterations over 4 threads.
procedure main()
    shared mutable a := array(1000, 0.0)
    shared mutable b := array(1000, 0.0)
    shared mutable c := array(1000, 0.0)
    shared mutable chunk := 0

    for i := 0 to 1000 do
        a[i] := i * 1.0
        b[i] := i * 1.0
    end for

    chunk := 100
    // #pragma omp parallel for shared(a,b,c,chunk) private(i) schedule(static,chunk)
    parallel for i := 0 to 1000 with 4 thread do
        c[i] := a[i] + b[i]
    end parallel for
end procedure
