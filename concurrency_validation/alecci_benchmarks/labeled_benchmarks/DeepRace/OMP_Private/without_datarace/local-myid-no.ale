// Full translation of 1.1-hello_-_main.c
// No race: myid and nthreads are private to each thread.
// The default team size of "#pragma omp parallel" is modelled as 4 threads.
procedure main()
    // #pragma omp parallel private(myid, nthreads)
    mutable threads := create_threads(4, worker)
    join_threads(threads, 4)
end procedure

procedure worker(thread_number as int)
    mutable myid := thread_number
    mutable nthreads := 4
    print `{myid} of {nthreads} - hello world!`
end procedure
