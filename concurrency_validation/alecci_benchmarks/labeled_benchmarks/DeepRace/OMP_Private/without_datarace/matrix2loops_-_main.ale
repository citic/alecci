// Full translation of matrix2loops_-_main.c
// Matrix product C = A x B: a first work-shared loop zeroes c, then for every
// row i the j loop is work-shared across the threads (each thread computes
// distinct elements c[i][j]).
// No race: the barriers that end each "omp for" separate the phases.
// Deviations: static int a/b/c[10000][10000] become flat 100 x 100 arrays
// (x[i][j] -> x[i * 100 + j]) and the size limit 10000 becomes 100; dim is read
// from stdin (matrix2loops_-_main.txt); rand() becomes rand(100) to keep the
// products small; gettimeofday/times timing is dropped, so only the clock
// messages are printed; "omp for schedule(static)" is a static block split.
procedure main()
    shared mutable dim as int := 0
    shared mutable a := array(10000, 0)
    shared mutable b := array(10000, 0)
    shared mutable c := array(10000, 0)
    shared mutable phase_barrier as barrier := barrier(4)

    print "Specify the dimension value"
    scan `{dim}`
    if dim > 100 then
        print "enter the range less than 100"
    end if

    for i := 0 to dim do
        for j := 0 to dim do
            a[i * 100 + j] := rand(100)
        end for
    end for

    for i := 0 to dim do
        for j := 0 to dim do
            b[i * 100 + j] := rand(100)
        end for
    end for

    print ``
    print "Starting clock."
    // #pragma omp parallel shared(a,b,c,dim) private(i,j,k)
    mutable threads := create_threads(4, worker)
    join_threads(threads, 4)
    print "Stopped clock."
    print ``
    print "Elapsed time = (not measured) ms."
end procedure

procedure worker(thread_number as int)
    const chunk = dim # 4
    const first = thread_number * chunk
    mutable last := first + chunk
    if thread_number = 3 then
        last := dim
    end if

    // #pragma omp for schedule(static): zero c by rows
    for i := first to last do
        for j := 0 to dim do
            c[i * 100 + j] := 0
        end for
    end for
    barrier_wait(phase_barrier)

    for i := 0 to dim do
        // #pragma omp for schedule(static): columns j are split across threads
        for j := first to last do
            for k := 0 to dim do
                c[i * 100 + j] := c[i * 100 + j] + a[i * 100 + k] * b[k * 100 + j]
            end for
        end for
        barrier_wait(phase_barrier)
    end for
end procedure
