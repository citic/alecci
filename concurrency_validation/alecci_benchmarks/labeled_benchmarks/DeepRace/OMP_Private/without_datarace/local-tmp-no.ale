// Full translation of outter_-_main.c with the missing private clause restored
// (race-free variant of shared-tmp-yes).
// No race: s_seq, sequence and aux are private to each iteration of the
// parallel for, so the threads never touch each other's buffers.
// Deviations: malloc'd buffers become
// local arrays of the largest size and the final "sequence = aux = 0" is
// omitted; pow(2, n) is 1 << n; the clock() timing is dropped; printf("%d ")
// fragments are one print per element.
procedure main()
    // #pragma omp parallel for  (private(s_seq, sequence, aux))
    parallel for p := 8 to 15 with 4 thread do
        mutable s_seq := 1 << p
        mutable sequence := array(16384, 0)
        mutable aux := array(16384, 0)
        for k := 0 to s_seq do
            sequence[k] := k
            aux[k] := k
        end for

        mutable jump := 0
        mutable a := 0
        mutable i := 0
        mutable j := 0
        while (1 << jump) < s_seq do
            if a = 0 then
                print `numbrs of threads: {thread_number}`
            end if
            a := 1
            i := s_seq - 1
            while i > 0 do
                j := i - (1 << jump)
                if j >= 0 then
                    sequence[i] := sequence[i] + sequence[j]
                else
                    i := 0
                end if
                i := i - 1
            end while
            jump := jump + 1
        end while

        for i2 := 0 to s_seq do
            print `{sequence[i2]} `
        end for
        print ``
    end parallel for
end procedure
