// Full translation of hello_for_-_main.c
// No race: myid and num_thds are private to each iteration.
// The default team size of "#pragma omp parallel for" is modelled as 4 threads.
procedure main()
    // #pragma omp parallel for private(myid, num_thds)
    parallel for i := 0 to 16 with 4 thread do
        mutable myid := thread_number
        mutable num_thds := 4
        print `i = {i}. Executed by thread {myid} out of {num_thds} threads.`
    end parallel for
end procedure
