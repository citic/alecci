// Full translation of 02_printf_g_thread.c with the mutex removed
// (race-injected variant of the mutex-protected original).
// Race: thread 1 does g_num++ and thread 2 does g_num-- (each also reading it for
// the printf) without g_mutex, which the C source takes around each update.
// Deviations: sleep(2) is scaled to 20 ms; the "\t" separating the two printf
// calls becomes two print lines; pthread_mutex_destroy has no equivalent.
procedure main()
    shared mutable g_num := 0

    mutable t1 := create_thread(thread_handle0, 1)
    mutable t2 := create_thread(thread_handle1, 2)

    join_thread(t1)
    print `thread[1] exit`
    join_thread(t2)
    print `thread[2] exit`
    print "main exit!"
end procedure

procedure thread_handle0(num as int)
    for i := 0 to 20 do
        print `in thread[{num}] before {g_num}`
        g_num := g_num + 1
        print `in thread[{num}] after {g_num}`
        sleep(20, "ms")
    end for
end procedure

procedure thread_handle1(num as int)
    for i := 0 to 20 do
        print `in thread[{num}] before {g_num}`
        g_num := g_num - 1
        print `in thread[{num}] after {g_num}`
        sleep(20, "ms")
    end for
end procedure
