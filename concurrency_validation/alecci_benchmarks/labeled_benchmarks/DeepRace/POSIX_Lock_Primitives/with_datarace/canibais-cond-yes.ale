// Full translation of 130024902_problema_canibais.c (cannibals and cook)
// Race: the cook writes porcoes := 10 outside the acordar mutex while the
// cannibals read and write porcoes under that mutex.
// Deviations: the C program loops forever (while TRUE) and only exits when the
// process is killed, so every cannibal stops after 3 meals and the last one
// tells the cook to finish (done counter); sleep(1) is scaled to 100 ms and
// sleep(5) to 500 ms (same ratio); the cook thread gets no argument; "\n" inside the printf strings
// becomes separate print calls.
procedure canibal(thread_number as int)
    mutable i := thread_number
    for meal := 0 to 3 do
        lock(acordar)
        if porcoes < 1 then
            cond_signal(cozinhar)
            cond_wait(comida, acordar)
        end if
        porcoes := porcoes - 1
        print `Canibal {i} pegou uma porcao`
        print `porcao: {porcoes}`
        sleep(100, "ms")
        unlock(acordar)

        lock(porcao)
        sleep(100, "ms")
        unlock(porcao)
    end for

    lock(acordar)
    done := done + 1
    if done = 5 then
        cond_signal(cozinhar)
    end if
    unlock(acordar)
end procedure

procedure cozinheiro()
    mutable running := 1
    while running = 1 do
        lock(acordar)
        while porcoes > 0 and done < 5 do
            cond_broadcast(comida)
            cond_wait(cozinhar, acordar)
        end while
        unlock(acordar)

        if done >= 5 then
            running := 0
        else
            print "------ COZINHEIRO ------"
            print "Preparando comida "
            sleep(500, "ms")
            porcoes := 10
            print `{porcoes} porcoes preparadas`
        end if
    end while
end procedure

procedure main()
    shared mutable acordar  as mutex   := mutex()
    shared mutable porcao   as mutex   := mutex()
    shared mutable cozinhar as condvar := condvar()
    shared mutable comida   as condvar := condvar()
    shared mutable porcoes := 10
    shared mutable done    := 0
    mutable cans := create_threads(5, canibal)
    mutable coz  := create_thread(cozinheiro)
    join_threads(cans)
    join_thread(coz)
end procedure
