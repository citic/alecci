// Full translation of muxtex_anpham.c with the mutex removed
// (race-injected variant of counter-mutex4-no).
// Race: the two threads run counter++ and read it for the printf without
// mutex1, which the C source takes around the increment.
// The pthread_create error checks are dropped (they only report failures).
procedure main()
    shared mutable counter := 0

    mutable thread1 := create_thread(function_c)
    mutable thread2 := create_thread(function_c)

    print "Hello from main"
    join_thread(thread1)
    join_thread(thread2)
    print "Exit from main"
end procedure

procedure function_c()
    counter := counter + 1
    print `Counter value: {counter}`
end procedure
