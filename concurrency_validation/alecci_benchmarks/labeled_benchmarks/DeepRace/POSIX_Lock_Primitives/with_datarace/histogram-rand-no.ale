// Full translation of assiOS.c
// Main fills a 10000-element array with random bucket ids 0..4; 5 threads
// partition it by stride 5 (thread k handles indices k, k+5, ...) and increment
// count[inputs[k]] under mutexprotect.
// Ground truth in the dataset: data_race. In this translation every access to
// count[] is inside the critical section, so TSan is not expected to report it.
// srand((int) tim) is omitted and rand() % 5 becomes rand(5); the "switch" over
// inputs[k] is the equivalent count[inputs[k]]++; printf("%d") of the inputs is
// one print per value.
procedure job(thread_number as int)
    mutable k := thread_number
    while k < 10000 do
        lock(mutexprotect)
        mutable bucket := inputs[k]
        count[bucket] := count[bucket] + 1
        unlock(mutexprotect)
        k := k + 5
    end while
end procedure

procedure main()
    shared mutable mutexprotect as mutex := mutex()
    shared mutable inputs as array := array(10000, 0)
    shared mutable count  as array := array(5, 0)

    for j := 0 to 10000 do
        inputs[j] := rand(5)
        print `{inputs[j]}`
    end for

    mutable t := create_threads(5, job)
    for i := 0 to 5 do
        print `Thread Started ={i}`
    end for
    join_threads(t, 5)

    mutable total := 0
    for i := 0 to 5 do
        print `Count of {i}={count[i]}`
        total := total + count[i]
    end for

    print `Total={total}`
end procedure
