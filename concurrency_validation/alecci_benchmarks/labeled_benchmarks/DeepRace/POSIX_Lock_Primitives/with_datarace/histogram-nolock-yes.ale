// Full translation of assiOS.c with the mutex removed
// (race-injected variant of histogram-rand-no).
// Race: the 5 threads (stride 5 over inputs[]) increment the shared count[]
// buckets without taking mutexprotect.
// srand((int) tim) is omitted and rand() % 5 becomes rand(5); the "switch" over
// inputs[k] is the equivalent count[inputs[k]]++; printf("%d") of the inputs is
// one print per value.
procedure main()
    shared mutable count := array(5, 0)
    shared mutable inputs := array(10000, 0)

    for j := 0 to 10000 do
        inputs[j] := rand(5)
        print `{inputs[j]}`
    end for

    mutable t := create_threads(5, job)
    print `Thread Started =0`
    join_threads(t, 5)

    mutable total := 0
    for i := 0 to 5 do
        print `Count of {i}={count[i]}`
        total := total + count[i]
    end for

    print `Total={total}`
end procedure

procedure job(thread_number as int)
    mutable k := thread_number
    while k < 10000 do
        // lock(mutexprotect) removed
        const bucket = inputs[k]
        count[bucket] := count[bucket] + 1
        // unlock(mutexprotect) removed
        k := k + 5
    end while
end procedure
