// Full translation of TwoThreadLoop.c
// The worker thread prints a row of 10 'A' and main a row of 100 'B', taking
// turns through flag, a mutex and a condition variable (both sides use "if", not
// "while", exactly as in the C source).
// Ground truth in the dataset: data_race. In this translation every access to
// flag is under the lock, so TSan is not expected to report it.
// The printf loops that print one character at a time are one print of the whole
// row, since print always ends the line.
procedure thread_func()
    for i := 0 to 50 do
        lock(lk)
        if flag != 0 then
            cond_wait(ready, lk)
        end if
        print `AAAAAAAAAA`
        flag := flag + 1
        unlock(lk)
        cond_broadcast(ready)
    end for
end procedure

procedure main()
    shared mutable lk    as mutex   := mutex()
    shared mutable ready as condvar := condvar()
    shared mutable flag := 0
    mutable tid := create_thread(thread_func)

    for i := 0 to 50 do
        lock(lk)
        if flag != 1 then
            cond_wait(ready, lk)
        end if
        print `BBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBBB`
        flag := flag - 1
        unlock(lk)
        cond_broadcast(ready)
    end for

    join_thread(tid)
end procedure
