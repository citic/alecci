// Full translation of muxtex_anpham.c
// Two threads run functionC: each takes mutex1, increments counter and prints it;
// main prints before and after joining.
// No race: counter is only accessed under mutex1. (The pthread_create error
// checks are dropped: they only report failures.)
procedure main()
    shared mutable counter := 0
    shared mutable mutex1 as mutex := mutex()

    mutable thread1 := create_thread(function_c)
    mutable thread2 := create_thread(function_c)

    print "Hello from main"
    join_thread(thread1)
    join_thread(thread2)
    print "Exit from main"
end procedure

procedure function_c()
    lock(mutex1)
    counter := counter + 1
    print `Counter value: {counter}`
    unlock(mutex1)
end procedure
