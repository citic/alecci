// Full translation of 04-random_sleep.c
// Same ABBA lock-order inversion as lock-order-no.ale, with a random pause before
// each first acquisition (usleep(rand() % 10000)).
// Ground truth: none (original dataset). TSan reports a lock-order inversion
// (potential deadlock); the program can deadlock, as the C one can.
// Deviations: usleep(rand() % 10000) is sleep(rand(10), "ms") (up to 10 ms);
// sleep(1) is scaled to 100 ms; trava3 is declared but unused in the C source.
procedure thread1(thread_number as int)
    for i := 0 to 5 do
        sleep(rand(10), "ms")
        lock(trava1)
        print "Thread 1 pegou mutex 1"
        sleep(100, "ms")
        print "Thread 1 tentando pegar trava 2"
        lock(trava2)
        print `Estou no loop da thread 1! i={i}`
        unlock(trava1)
        unlock(trava2)
    end for
end procedure

procedure thread2(thread_number as int)
    for i := 0 to 5 do
        sleep(rand(10), "ms")
        lock(trava2)
        print "Thread 2 pegou mutex 2"
        sleep(100, "ms")
        print "Thread 2 tentando pegar trava 1"
        lock(trava1)
        print `Estou no loop da thread 2! i={i}`
        unlock(trava2)
        unlock(trava1)
    end for
end procedure

procedure main()
    shared mutable trava1 as mutex := mutex()
    shared mutable trava2 as mutex := mutex()
    mutable t1 := create_threads(1, thread1)
    mutable t2 := create_threads(1, thread2)
    join_threads(t1, 1)
    join_threads(t2, 1)
    print "Fim de programa!"
end procedure
