// Full translation of ThreadSynCondition.c
// Circular buffer (SIZE = 4): the producer puts 0..19 followed by the OVER = -1
// sentinel and the consumer reads until it sees the sentinel. Two condition
// variables (notempty, notfull) and one lock protect rpos, wpos and the buffer.
// The struct producer fields are separate shared variables, Init() is the
// initialisation in main, and pthread_join's return value is not used.
procedure put_item(data as int)
    lock(buf_lock)

    while (wpos + 1) mod 4 = rpos do
        cond_wait(notfull, buf_lock)
    end while

    buf[wpos] := data
    wpos := wpos + 1

    if wpos >= 4 then
        wpos := 0
    end if

    cond_signal(notempty)
    unlock(buf_lock)
end procedure

function get_item()
    lock(buf_lock)

    while wpos = rpos do
        cond_wait(notempty, buf_lock)
    end while

    mutable data := buf[rpos]
    rpos := rpos + 1

    if rpos >= 4 then
        rpos := 0
    end if

    cond_signal(notfull)
    unlock(buf_lock)

    return data
end function

procedure producer()
    for n := 0 to 20 do
        print `Producer:{n}-->`
        put_item(n)
    end for
    put_item(-1)
end procedure

procedure consumer()
    mutable running := 1
    while running = 1 do
        mutable d := get_item()
        if d = -1 then
            running := 0
        else
            print `Consumer:-->{d}`
        end if
    end while
end procedure

procedure main()
    shared mutable buf      as array  := array(4, 0)
    shared mutable rpos := 0
    shared mutable wpos := 0
    shared mutable buf_lock  as mutex   := mutex()
    shared mutable notempty  as condvar := condvar()
    shared mutable notfull   as condvar := condvar()

    mutable tha := create_thread(producer)
    mutable thb := create_thread(consumer)
    join_thread(tha)
    join_thread(thb)
end procedure
