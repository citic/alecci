// Full translation of a_-_main.c
// Race: parallel for finds max of arr[] without a critical section
// (if max < arr[i] then max := arr[i]). rand() % 100 becomes rand(100).
procedure main()
    shared mutable arr := array(10, 0)
    shared mutable max := -1
    for i := 0 to 10 do
        arr[i] := rand(100)
    end for

    // #pragma omp parallel for schedule(static)
    parallel for i := 0 to 10 with 4 thread do
        if max < arr[i] then
            max := arr[i]
        end if
    end parallel for

    print `{max} is max`
end procedure
