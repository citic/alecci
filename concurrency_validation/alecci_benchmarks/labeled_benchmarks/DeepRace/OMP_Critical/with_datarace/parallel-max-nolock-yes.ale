// Full translation of omp12_-_main.c with the "#pragma omp critical" removed
// (race-injected variant of the without_datarace benchmark).
// Race: max < a[i] is tested and max = a[i] is written by several threads with
// no synchronisation at all.
// srand(time(0)) is omitted; rand() % 300 becomes rand(300).
procedure main()
    shared mutable a := array(300, 0)
    shared mutable max := -1
    mutable base_max := -1

    for i := 0 to 300 do
        a[i] := rand(300)
        if a[i] mod 7 = 0 and base_max < a[i] then
            base_max := a[i]
        end if
    end for

    // #pragma omp parallel for shared(max)
    parallel for i := 0 to 300 with 4 thread do
        if a[i] mod 7 = 0 and max < a[i] then
            max := a[i]
        end if
    end parallel for

    print `{max}`
    if base_max = max then
        print "correct"
    end if
end procedure
