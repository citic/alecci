// Full translation of hw8_p1a_-_main.c
// Race: parallel for where odd-numbered threads do count++ and even-numbered
// threads do count-- on a shared counter, without a critical section.
procedure main()
    for test := 1 to 101 do
        shared mutable count := 0
        count := 0
        // #pragma omp parallel for
        parallel for i := 1 to 10001 with 4 thread do
            if thread_number mod 2 = 1 then
                count := count + 1
            else
                count := count - 1
            end if
        end parallel for

        // C prints 10 results per line; print always ends the line in Alecci
        print `{count}`
    end for
end procedure
