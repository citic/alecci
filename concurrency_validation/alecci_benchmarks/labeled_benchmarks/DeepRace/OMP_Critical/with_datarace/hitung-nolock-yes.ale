// Full translation of hitung_-_main.c
// Race: 10 threads each sum their own 10-number slice of 1..100, then do
// "total = total + local_total" without a critical section.
procedure main()
    shared mutable total := 0
    shared const batas = 100
    shared const jml_thread = 10

    print "Output programnya adalah : "
    // #pragma omp parallel num_threads(10)
    mutable threads := create_threads(jml_thread, worker)
    join_threads(threads, 10)

    print `Hasil akhir {total}`
end procedure

procedure worker(thread_number as int)
    mutable id_thread := thread_number
    mutable jml_hitung_tiap_thread := batas # jml_thread
    mutable local_total := 0
    mutable first := id_thread * jml_hitung_tiap_thread + 1
    mutable last := (id_thread + 1) * jml_hitung_tiap_thread
    for i := first to last + 1 do
        local_total := local_total + i
    end for

    total := total + local_total
end procedure
