// Full translation of 05_omp_crit_-_main.c
// Race: every thread does "x = x + 1" on the shared x inside the parallel
// region, without the critical section the file name refers to.
// The default team size of "#pragma omp parallel" is modelled as 4 threads.
procedure main()
    shared mutable x := 0

    // #pragma omp parallel shared(x)
    mutable threads := create_threads(4, worker)
    join_threads(threads, 4)
end procedure

procedure worker(thread_number as int)
    x := x + 1
end procedure
