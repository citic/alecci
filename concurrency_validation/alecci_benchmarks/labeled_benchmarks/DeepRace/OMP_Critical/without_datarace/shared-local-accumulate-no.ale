// Full translation of datasharing_-_main.c with the missing critical section
// restored (race-free variant of the with_datarace benchmark).
// No race: "m += s" is an atomic block; nt is written only by thread 0
// ("#pragma omp master") and read after the join.
// Assert: 4 threads x 10000 = 40000 must hold after the join.
procedure main()
    shared mutable nt := 0
    shared mutable m := 0
    shared const num_threads = 4

    // #pragma omp parallel shared(m,nt) firstprivate(s)
    mutable threads := create_threads(num_threads, worker)
    join_threads(threads, 4)

    assert m = 40000, "4 threads x 10000 local increments must sum to 40000"
    if m = nt * 10000 then
        print "Success!"
    else
        print "Fail!"
    end if
end procedure

procedure worker(thread_number as int)
    mutable s := 0
    for i := 0 to 10000 do
        s := s + 1
    end for

    atomic do
        m := m + s
    end atomic
    // #pragma omp master
    if thread_number = 0 then
        nt := num_threads
    end if
end procedure
