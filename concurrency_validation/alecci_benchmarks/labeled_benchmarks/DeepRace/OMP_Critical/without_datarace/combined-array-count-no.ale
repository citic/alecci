// Full translation of simple_combined_pfor_-_main.c
// No race: a[i] writes go to distinct indices; count++ is inside the critical
// section (mutex).
procedure main()
    shared mutable a := array(100, 0)
    shared mutable count := 0
    shared mutable count_mutex as mutex := mutex()

    // #pragma omp parallel for
    parallel for i := 0 to 100 with 4 thread do
        a[i] := i
        // #pragma omp critical
        lock(count_mutex)
        count := count + 1
        unlock(count_mutex)
    end parallel for

    for i := 0 to 100 do
        print `a[{i}]={a[i]}`
    end for

    print `count: {count}`
end procedure
