// Full translation of 2.hello_-_main.c
// No race: id is assigned and printed inside the critical section (mutex).
// The two printf calls (Hello / world!) are one print here, since print always
// ends the line. The default team size of "#pragma omp parallel" is 4 threads.
procedure main()
    shared mutable id := 0
    shared mutable id_mutex as mutex := mutex()

    // #pragma omp parallel
    mutable threads := create_threads(4, worker)
    join_threads(threads, 4)
end procedure

procedure worker(thread_number as int)
    // #pragma omp critical
    lock(id_mutex)
    id := thread_number
    print `({id}) Hello ({id}) world!`
    unlock(id_mutex)
end procedure
