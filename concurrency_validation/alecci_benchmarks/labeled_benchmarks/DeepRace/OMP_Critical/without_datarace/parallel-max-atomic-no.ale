// Full translation of omp12_-_main.c
// No race: the max < a[i] test and the max = a[i] update form one atomic block.
// Deviation: in the C source the test sits outside the "#pragma omp critical";
// here both are inside the atomic block so the benchmark stays race free.
// srand(time(0)) is omitted; rand() % 300 becomes rand(300). The assert checks
// the same property as the "correct" line printed by the C program.
procedure main()
    shared mutable a := array(300, 0)
    shared mutable max := -1
    mutable base_max := -1

    for i := 0 to 300 do
        a[i] := rand(300)
        if a[i] mod 7 = 0 and base_max < a[i] then
            base_max := a[i]
        end if
    end for

    // #pragma omp parallel for shared(max)
    parallel for i := 0 to 300 with 4 thread do
        atomic do
            if a[i] mod 7 = 0 and max < a[i] then
                max := a[i]
            end if
        end atomic
    end parallel for

    print `{max}`
    if base_max = max then
        print "correct"
    end if
    assert max = base_max, "parallel max must equal the serial max"
end procedure
