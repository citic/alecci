// Full translation of histogramaSerie_-_main.c
// Builds a random image IMA, computes its grey-level histogram in parallel,
// finds the least frequent level (imin) and then scans each row up to the first
// pixel equal to imin (vectors B and C, total SPM).
// No race: the C loop "histo[IMA[i][j]]++" is a plain increment on the shared
// histogram (a race in C, although the dataset labels it race free); here the
// increment is done under a mutex to match the no-race ground truth label.
// Deviations: IMA[1000][1000] is scaled to 100 x 100 and flattened
// (IMA[i][j] -> IMA[i * 100 + j], one spare cell for the C bounds read);
// rand() % 256 becomes rand(256); gettimeofday timing is dropped.
procedure main()
    shared const n = 100
    shared mutable IMA := array(10001, 0)
    shared mutable histo := array(256, 0)
    shared mutable mtx as mutex := mutex()
    mutable B := array(100, 0)
    mutable C := array(100, 0)
    mutable spm := 0
    mutable hmin := 0
    mutable imin := 0

    for i := 0 to n do
        for j := 0 to n do
            IMA[i * n + j] := rand(256)
        end for
    end for

    print ` Matriz IMA `
    for i := 0 to 10 do
        print ``
        for j := 0 to 10 do
            print ` {IMA[i * n + j]}`
        end for
        print ``
    end for

    for i := 0 to 256 do
        histo[i] := 0
    end for

    // #pragma omp parallel private(histop, j)
    mutable threads := create_threads(4, worker)
    join_threads(threads, 4)

    hmin := n * n + 1
    for i := 0 to 256 do
        if hmin > histo[i] then
            hmin := histo[i]
            imin := i
        end if
    end for

    for i := 0 to n do
        mutable j := 0
        mutable x := 0
        while IMA[i * n + j] != imin and j < n do
            x := x + IMA[i * n + j]
            j := j + 1
        end while
        B[i] := x
        C[i] := j
        spm := spm + j
    end for

    print ``
    print ` Histograma `
    for i := 0 to 10 do
        print `{i}`
    end for
    print ``
    for i := 0 to 10 do
        print `{histo[i]}`
    end for
    print ` hmin = {hmin} imin = {imin}`
    print ``
    print ` Vector B `
    for i := 0 to 10 do
        print ` {B[i]}`
    end for
    print ``
    print ` Vector C `
    for i := 0 to 10 do
        print ` {C[i]}`
    end for
    print ``
    print ` SPM = {spm}`
end procedure

procedure worker(thread_number as int)
    mutable histop := array(256, 0)
    for i := 0 to 256 do
        histop[i] := 0
    end for

    // #pragma omp for: static block distribution of the rows
    const chunk = n # 4
    const first = thread_number * chunk
    mutable last := first + chunk
    if thread_number = 3 then
        last := n
    end if
    for i := first to last do
        for j := 0 to n do
            mutable bucket := IMA[i * n + j]
            lock(mtx)
            histo[bucket] := histo[bucket] + 1
            unlock(mtx)
        end for
    end for

    // #pragma omp critical
    lock(mtx)
    for i := 0 to 256 do
        histo[i] := histo[i] + histop[i]
    end for
    print `ejecutando hilo`
    unlock(mtx)
end procedure
