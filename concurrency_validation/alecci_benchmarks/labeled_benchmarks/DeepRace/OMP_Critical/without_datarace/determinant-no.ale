// Full translation of determ_-_main.c
// No race: the printf+product inside each "#pragma omp critical" and the merge
// "sum_p += sum" are protected by the same mutex; the rest is thread-private.
// m[2][2] is flattened to m[i * 2 + j]; srand(time(0)) is omitted and
// (rand() % n) + 1 becomes rand(n) + 1. The "[j,k]" printf fragments are one
// print per element because print always ends the line.
procedure main()
    shared const n = 2
    shared mutable m := array(4, 0)
    shared mutable sum_p := 0
    shared mutable mtx as mutex := mutex()

    for i := 0 to n do
        for j := 0 to n do
            m[i * 2 + j] := rand(n) + 1
        end for
        print ` {m[i * 2]} {m[i * 2 + 1]}`
    end for

    // #pragma omp parallel num_threads(n)
    mutable threads := create_threads(n, worker)
    join_threads(threads, 2)

    print `Suma posi: {sum_p}`
end procedure

procedure worker(thread_number as int)
    mutable sum := 1
    mutable i := thread_number
    for j := 0 to n do
        // #pragma omp critical
        lock(mtx)
        const col = (j + i) mod n
        print `[{j},{col}]`
        sum := sum * m[j * 2 + col]
        unlock(mtx)
    end for

    // #pragma omp critical
    lock(mtx)
    sum_p := sum_p + sum
    unlock(mtx)

    print `Thread() {i} Suma:{sum} `
end procedure
