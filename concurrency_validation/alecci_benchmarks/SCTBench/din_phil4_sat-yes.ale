// SCTBench benchmark: concurrent-software-benchmarks/din_phil4_sat.c
// Full translation of din_phil4_sat.c: 4 dining philosophers with a shared counter 'phil'.
// Each thread takes the right fork and then the left fork (x[right], x[left]) between
// __ESBMC_atomic_begin()/end() (lock/unlock of esbmc_m), then ++phil and
// "if (phil == N) assert(0)".
// BUG: ++phil (and the phil == N check) run after __ESBMC_atomic_end(), so they are not
// protected: concurrent increments of 'phil' are a data race.
// TSan also reports a lock-order inversion on the fork mutexes (deadlock warning).
// Expected: bug per the SCTBench ground truth.

procedure thread1(thread_number as int)
    mutable id := thread_number
    mutable left := id
    mutable right := (id + 1) % 4
    lock(esbmc_m)
    lock(x[right])
    lock(x[left])
    unlock(x[left])
    unlock(x[right])
    unlock(esbmc_m)
    phil := phil + 1
    if phil = 4 then
        assert 0 = 1, "assert(0): all 4 philosophers have eaten"
    end if
end procedure

procedure main()
    shared mutable esbmc_m as mutex := mutex()
    shared mutable x := array(4, mutex())
    shared mutable phil := 0
    mutable trd_id := create_threads(4, thread1)
    join_threads(trd_id, 4)
end procedure
