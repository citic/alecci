// SCTBench benchmark: concurrent-software-benchmarks/wronglock_bad.c
// Full translation of wronglock_bad.c: iNum1 = 1 funcA thread and iNum2 = 7 funcB threads.
// funcA protects dataValue with dataLock but funcB uses thisLock, so the two kinds of
// thread race on dataValue. funcA also checks that its own increment was not lost
// (the "Bug Found!" assertion).
// The optional command line parameters (iNum1, iNum2) are read as in C; the usage
// message, the pthread error checks and the lock()/unlock() wrappers around
// pthread_mutex_lock/unlock are not modelled.
// Expected: data race on variable data_value.

procedure funcA(thread_number as int)
    lock(dataLock)
    mutable x := dataValue
    dataValue := dataValue + 1
    if dataValue != (x + 1) then
        print "Bug Found!"
        assert 0 = 1, "Bug Found!"
    end if
    unlock(dataLock)
end procedure

procedure funcB(thread_number as int)
    lock(thisLock)
    dataValue := dataValue + 1
    unlock(thisLock)
end procedure

procedure main(argc, argv as array)
    shared mutable iNum1 := 1
    shared mutable iNum2 := 7
    shared mutable dataLock as mutex := mutex()
    shared mutable thisLock as mutex := mutex()
    shared mutable dataValue := 0

    if argc = 3 then
        iNum1 := int(argv[1])
        iNum2 := int(argv[2])
    end if

    mutable num1Pool := create_threads(iNum1, funcA)
    mutable num2Pool := create_threads(iNum2, funcB)
    join_threads(num1Pool, iNum1)
    join_threads(num2Pool, iNum2)
end procedure
