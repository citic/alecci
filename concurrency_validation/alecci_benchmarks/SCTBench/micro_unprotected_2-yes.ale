// SCTBench benchmark: concurrent-software-benchmarks/micro_2_ok.c
// Full translation of micro_2_ok.c: 2 threads (t1..t2) each perform 100 unprotected
// "x++" and then check the value they see (if (x <= 0) assert(0)).
// The 100 unrolled x++ statements of each C thread are a 100-iteration loop. The C main
// returns without joining the threads; the Alecci main joins them.
// Expected: data race on variable x.

procedure worker(thread_number as int)
    for i := 0 to 100 do
        x := x + 1
    end for
    if x <= 0 then
        assert 0 = 1, "assert(0): x must not be <= 0 after the increments"
    end if
end procedure

procedure main()
    shared mutable x := 0
    mutable threads := create_threads(2, worker)
    join_threads(threads, 2)
end procedure
