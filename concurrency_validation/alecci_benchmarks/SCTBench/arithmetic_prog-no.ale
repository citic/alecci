// SCTBench benchmark: concurrent-software-benchmarks/arithmetic_prog_ok.c
// Full translation of arithmetic_prog_ok.c: producer-consumer with accumulation over N = 4
// iterations. Two condition variables coordinate a 1-slot buffer; the consumer adds
// j = 0..N-1 to total under the mutex, then (outside the lock, as in C) adds the final j
// and sets flag; main asserts total == N*(N+1)/2 after the joins.
// No data race: the post-loop accesses belong to the consumer only and main reads them
// after the join.
// Expected: no data race.

procedure producer(thread_number as int)
    mutable i := 0
    while i < 4 do
        lock(m)
        while num > 0 do
            cond_wait(empty, m)
        end while
        num := num + 1
        print `produce ....{i}`
        unlock(m)
        cond_signal(full)
        i := i + 1
    end while
end procedure

procedure consumer(thread_number as int)
    mutable j := 0
    while j < 4 do
        lock(m)
        while num = 0 do
            cond_wait(full, m)
        end while
        total := total + j
        print `total ....{total}`
        num := num - 1
        print `consume ....{j}`
        unlock(m)
        cond_signal(empty)
        j := j + 1
    end while
    total := total + j
    print `total ....{total}`
    flag := 1
end procedure

procedure main()
    shared mutable m     as mutex   := mutex()
    shared mutable empty as condvar := condvar()
    shared mutable full  as condvar := condvar()
    shared mutable num   := 0
    shared mutable total := 0
    shared mutable flag  := 0
    mutable t1 := create_threads(1, producer)
    mutable t2 := create_threads(1, consumer)
    join_threads(t1, 1)
    join_threads(t2, 1)
    if flag = 1 then
        assert total = (4 * (4 + 1)) # 2, "total == N*(N+1)/2"
    end if
end procedure
