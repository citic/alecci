// SCTBench benchmark: concurrent-software-benchmarks/queue_bad.c
// Full translation of queue_bad.c.
// Atomicity violation: a 20-slot circular queue (head/tail/amount) is shared between a
// producer t1 and a consumer t2. t1 enqueues 0..19 when enqueue_flag is set and t2
// dequeues when dequeue_flag is set; both advance their loop counters regardless of
// whether they acted. Bug: t2's index into stored_elements diverges from the dequeue
// sequence, so assert(queue_dequeue(&queue) == stored_elements[i]) can fail.
// All shared accesses are under a single mutex: no data race, TSan cannot detect this
// class of bug.
// QType is a record (head/tail/amount); the element array is a separate shared array
// because Alecci does not support record.field[index]. The QType * parameters of the C
// helpers are the global queue, and init/empty/full/enqueue/dequeue are renamed
// queue_init/queue_empty/queue_full/queue_enqueue/queue_dequeue because enqueue and
// dequeue are Alecci built-ins.

record QType of
    head   as int
    tail   as int
    amount as int
end record

function queue_init()
    q.head := 0
    q.tail := 0
    q.amount := 0
    return 0
end function

function queue_empty()
    if q.head = q.tail then
        print "queue is empty"
        return -1
    else
        return 0
    end if
end function

function queue_full()
    if q.amount = 20 then
        print "queue is full"
        return -2
    else
        return 0
    end if
end function

function queue_enqueue(x as int)
    q_elements[q.tail] := x
    q.amount := q.amount + 1
    if q.tail = 20 then
        q.tail := 1
    else
        q.tail := q.tail + 1
    end if
    return 0
end function

function queue_dequeue()
    mutable x := q_elements[q.head]
    q.amount := q.amount - 1
    if q.head = 20 then
        q.head := 1
    else
        q.head := q.head + 1
    end if
    return x
end function

procedure t1(thread_number as int)
    mutable value := 0
    lock(m)
    value := 0
    assert queue_enqueue(value) = 0, "!queue_enqueue(&queue, value)"
    stored_elements[0] := value
    assert queue_empty() = 0, "!queue_empty(&queue)"
    unlock(m)
    for i := 0 to 19 do
        lock(m)
        if enqueue_flag = 1 then
            value := value + 1
            queue_enqueue(value)
            stored_elements[i + 1] := value
            enqueue_flag := 0
            dequeue_flag := 1
        end if
        unlock(m)
    end for
end procedure

procedure t2(thread_number as int)
    for i := 0 to 20 do
        lock(m)
        if dequeue_flag = 1 then
            assert queue_dequeue() = stored_elements[i], "queue_dequeue(&queue) == stored_elements[i]"
            dequeue_flag := 0
            enqueue_flag := 1
        end if
        unlock(m)
    end for
end procedure

procedure main()
    shared mutable m               as mutex  := mutex()
    shared mutable q               as QType  := {0, 0, 0}
    shared mutable q_elements      as array  := array(20, 0)
    shared mutable stored_elements as array  := array(20, 0)
    shared mutable enqueue_flag    as int    := 0
    shared mutable dequeue_flag    as int    := 0

    enqueue_flag := 1
    dequeue_flag := 0
    queue_init()
    assert queue_empty() = -1, "queue_empty(&queue) == EMPTY"
    mutable id1 := create_threads(1, t1)
    mutable id2 := create_threads(1, t2)
    join_threads(id1, 1)
    join_threads(id2, 1)
end procedure
