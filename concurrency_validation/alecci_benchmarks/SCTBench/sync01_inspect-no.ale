// SCTBench benchmark: inspect_examples/sync01.c
// Full translation of sync01.c: minimal 1-slot producer-consumer, one item produced and
// one consumed. thread1 waits on 'empty' while the slot is occupied, fills it, prints
// "producing ...." and signals 'full'; thread2 waits on 'full' while the slot is empty,
// empties it, prints "consume ...." and signals 'empty'.
// All accesses to num are under the mutex: no data race.
// Expected: no data race.

procedure thread1(thread_number as int)
    lock(m)
    while num > 0 do
        cond_wait(empty, m)
    end while
    num := num + 1
    print "producing ...."
    unlock(m)
    cond_signal(full)
end procedure

procedure thread2(thread_number as int)
    lock(m)
    while num = 0 do
        cond_wait(full, m)
    end while
    num := num - 1
    print "consume ...."
    unlock(m)
    cond_signal(empty)
end procedure

procedure main()
    shared mutable m     as mutex   := mutex()
    shared mutable empty as condvar := condvar()
    shared mutable full  as condvar := condvar()
    shared mutable num := 0
    mutable t1 := create_threads(1, thread1)
    mutable t2 := create_threads(1, thread2)
    join_threads(t1, 1)
    join_threads(t2, 1)
end procedure
