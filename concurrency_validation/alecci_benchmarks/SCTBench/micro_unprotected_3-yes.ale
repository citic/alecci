// SCTBench benchmark: concurrent-software-benchmarks/micro_3_ok.c
// Full translation of micro_3_ok.c: 3 threads (t1..t3) each perform 100 unprotected
// "x++" and then check the value they see (assert(0 < x)).
// The 100 unrolled x++ statements of each C thread are a 100-iteration loop. The C main
// returns without joining the threads; the Alecci main joins them.
// Expected: data race on variable x.

procedure worker(thread_number as int)
    for i := 0 to 100 do
        x := x + 1
    end for
    assert 0 < x, "assert(0<x): x must be positive after the increments"
end procedure

procedure main()
    shared mutable x := 0
    mutable threads := create_threads(3, worker)
    join_threads(threads, 3)
end procedure
