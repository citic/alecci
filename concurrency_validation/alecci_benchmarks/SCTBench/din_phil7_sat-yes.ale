// SCTBench benchmark: concurrent-software-benchmarks/din_phil7_sat.c
// Full translation of din_phil7_sat.c: 7 dining philosophers with a shared counter 'phil'.
// Each thread takes the right fork and then the left fork (x[right], x[left]) between
// __ESBMC_atomic_begin()/end() (lock/unlock of esbmc_m), then ++phil and
// "if (phil == N) assert(0)".
// In this variant ++phil and the phil == N check follow __ESBMC_atomic_begin() calls
// and are therefore inside the atomic section: 'phil' is protected, the bug is the
// assertion failure reached when all 7 philosophers ran.
// TSan also reports a lock-order inversion on the fork mutexes (deadlock warning).
// Expected: bug per the SCTBench ground truth.

procedure thread1(thread_number as int)
    mutable id := thread_number
    mutable left := id
    mutable right := (id + 1) % 7
    lock(esbmc_m)
    lock(x[right])
    lock(x[left])
    unlock(x[left])
    unlock(x[right])
    // The C source has __ESBMC_atomic_begin() three times and a single
    // __ESBMC_atomic_end(); ESBMC's atomic sections nest, so they are one balanced
    // lock/unlock of esbmc_m around the first block and one around ++phil here.
    unlock(esbmc_m)
    lock(esbmc_m)
    phil := phil + 1
    if phil = 7 then
        assert 0 = 1, "assert(0): all 7 philosophers have eaten"
    end if
    unlock(esbmc_m)
end procedure

procedure main()
    shared mutable esbmc_m as mutex := mutex()
    shared mutable x := array(7, mutex())
    shared mutable phil := 0
    mutable trd_id := create_threads(7, thread1)
    join_threads(trd_id, 7)
end procedure
