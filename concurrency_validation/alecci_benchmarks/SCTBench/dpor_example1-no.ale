// SCTBench benchmark: inspect_examples/dpor-example1.c
// Full translation of dpor-example1.c: concurrent open-addressing hash table with one
// mutex per slot (SIZE = 128, MAX = 4, NUM_THREADS = 13). Each thread inserts MAX values
// w = (++m) * 11 + tid at h = (w * 7) % SIZE, probing linearly with the compare-and-swap
// helper cas(), which locks cas_mutex[h].
// pthread_exit(NULL) is the end of the worker procedure; the mutex destroy loop in main
// has no Alecci equivalent.
// Expected: no data race.

function cas(h as int, val as int, new_val as int)
    mutable ret_val := 0
    lock(cas_mutex[h])
    if table[h] = val then
        table[h] := new_val
        ret_val := 1
    end if
    unlock(cas_mutex[h])
    return ret_val
end function

procedure thread_routine(thread_number as int)
    mutable tid := thread_number
    mutable m := 0
    mutable w := 0
    mutable h := 0
    while m < 4 do
        m := m + 1
        w := m * 11 + tid
        h := (w * 7) % 128
        while cas(h, 0, w) = 0 do
            h := (h + 1) % 128
        end while
    end while
end procedure

procedure main()
    shared mutable table := array(128, 0)
    shared mutable cas_mutex := array(128, mutex())
    mutable tids := create_threads(13, thread_routine)
    join_threads(tids, 13)
end procedure
