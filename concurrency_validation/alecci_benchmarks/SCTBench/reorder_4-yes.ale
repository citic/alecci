// SCTBench benchmark: concurrent-software-benchmarks/reorder_4_bad.c
// Full translation of reorder_4_bad.c: iSet = 3 set threads write a = 1; b = -1 and
// iCheck = 1 check thread assert that (a, b) is either (0, 0) or (1, -1), all without synchronisation.
// Bug: memory reorder / data race between setThread and checkThread.
// The optional command line parameters (iSet, iCheck) are read as in C; the usage
// message and the exit(-1) error paths of pthread_create/pthread_join are not modelled.
// Expected: data race on variables a and b.

procedure set_worker(thread_number as int)
    a := 1
    b := -1
end procedure

procedure check_worker(thread_number as int)
    if not ((a = 0 and b = 0) or (a = 1 and b = -1)) then
        print "Bug found!"
        assert 0 = 1, "Bug found!"
    end if
end procedure

procedure main(argc, argv as array)
    shared mutable iSet := 3
    shared mutable iCheck := 1
    shared mutable a := 0
    shared mutable b := 0

    if argc = 3 then
        iSet := int(argv[1])
        iCheck := int(argv[2])
    end if

    mutable t_set := create_threads(iSet, set_worker)
    mutable t_check := create_threads(iCheck, check_worker)
    join_threads(t_set, iSet)
    join_threads(t_check, iCheck)
end procedure
